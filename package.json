{
  "name": "hrms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Human Resource Management System (Fullstack Monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:full": "node server/scripts/devLauncher.js",
    "test:verification": "node --test server/src/tests/attendance.verification.test.js",
    "test:findings": "node --test server/src/tests/findings1_2.atomicity_geofence.test.js",
    "test:face-startup": "node --test server/src/tests/face_service_startup.test.js",
    "test:mfa": "node --test server/src/tests/auth.mfa.test.js",
    "test:mfa:all-roles": "node server/scripts/test-mfa-suite.js",
    "build": "echo 'Backend deployment ready'",
    "build:client": "npm run build --workspace=client",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server",
    "graphify": "python server/scripts/build-graphify.py"
  },
  "keywords": [
    "hrms",
    "attendance",
    "payroll",
    "react",
    "nodejs",
    "postgresql",
    "railway"
  ],
  "author": "",
  "license": "ISC"
}
